{
  "expo": {
    "name": "Go Back",
    "slug": "go-back",
    "scheme": "goback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.goback.focus",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07130F"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#07130F",
          "dark": {
            "backgroundColor": "#07130F"
          }
        }
      ],
      "./plugins/withGoBackWidget"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
